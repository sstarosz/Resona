# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
.venv-*/

# Tooling caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.agents/

# Build artifacts
*.so
*.mll
*.bundle
build/
dist/
*.egg-info/
# Generated by CMake from git tags
_version.py

# Test logs
test-logs/

# Scratch — local notes, probes, experiments (never committed)
scratch/

# C++ / CMake
/out/
.vs/
CMakeFiles/
CMakeCache.txt
CMakeUserPresets.json

# Third party — external reference projects (not part of the plugin)
third_party/

# vcpkg — local installs
vcpkg_installed/

# VS Code — generated Maya API stubs
.vscode/stubs/

# Maya
*.swatch
*.tx
.mayaSwatches/
*.mb
incrementalSave/

# Assets — user-provided test files (READMEs are tracked, binaries are ignored)
assets/*
!assets/README.md

# pytest temporary directories
pytest-of-*/
