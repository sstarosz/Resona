# Resona — C++ code formatting configuration
# LLVM base style with 4-space indent (matching existing code).
#
# Usage:
#   clang-format -i <files>            # format in-place
#   clang-format --dry-run -Werror ... # check (CI)

BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 100

# Break before braces: attach to namespace/class/function opening
BreakBeforeBraces: Allman

# Pointer alignment: left (int *ptr)
PointerAlignment: Left

# Include sorting
SortIncludes: CaseSensitive
IncludeBlocks: Preserve

# Spacing
SpaceAfterCStyleCast: true
SpaceBeforeAssignmentOperators: true
SpacesInParentheses: false
SpacesInSquareBrackets: false

# Align trailing comments
AlignTrailingComments: true

# Allow short functions/lambdas on a single line
AllowShortFunctionsOnASingleLine: Inline
AllowShortLambdasOnASingleLine: All

# Braces around every if / else / for / while body, even one-liners
# (clang-format >= 15).
InsertBraces: true
